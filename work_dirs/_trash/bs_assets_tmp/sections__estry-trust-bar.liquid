{% comment %} estry-trust-bar-v1 {% endcomment %}
<section class="etb">
  <div class="etb__inner page-width">
    {%- for block in section.blocks -%}
      <div class="etb__item" {{ block.shopify_attributes }}>
        <span class="etb__ico">
          {%- case block.settings.icon -%}
            {%- when 'truck' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M1 4h13v12H1z"/><path d="M14 9h4.5L21 12.5V16h-7"/><circle cx="5.5" cy="18.5" r="2"/><circle cx="17.5" cy="18.5" r="2"/></svg>{%- when 'shield' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 2l8 3v6c0 5-3.4 8.6-8 10-4.6-1.4-8-5-8-10V5z"/><path d="M8.5 11.5 11 14l4.5-4.5"/></svg>{%- when 'rotate' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3.5 12a8.5 8.5 0 1 0 2.8-6.3"/><path d="M3.5 4v5h5"/></svg>{%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M13 2 3 14h7l-1 8 10-12h-7z"/></svg>{%- endcase -%}
        </span>
        <span class="etb__txt">
          <strong>{{ block.settings.title | escape }}</strong>
          <span>{{ block.settings.subtitle | escape }}</span>
        </span>
      </div>
    {%- endfor -%}
  </div>
</section>
<style>
  /* Dawn 全局 1rem=10px（html 62.5%），字号按 px÷10 写 rem */
  .etb{background:#f6f8fa;border-bottom:1px solid #e8edf2;}
  .etb__inner{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;padding:22px 1.5rem;}
  .etb__item{display:flex;align-items:center;gap:12px;justify-content:center;}
  .etb__ico{flex:0 0 42px;width:42px;height:42px;border-radius:50%;background:#e6f7ee;color:#00A651;display:flex;align-items:center;justify-content:center;}
  .etb__ico svg{width:21px;height:21px;}
  .etb__txt{display:flex;flex-direction:column;line-height:1.3;text-align:left;}
  .etb__txt strong{font-size:1.4rem;color:#1B2A41;}
  .etb__txt span{font-size:1.2rem;color:#5a6b7d;}
  @media (max-width:899px){.etb__inner{grid-template-columns:repeat(2,1fr);gap:16px 10px;padding:18px 1rem;}}
</style>
{% schema %}
{
  "name": "ESTRY Trust Bar",
  "settings": [],
  "blocks": [
    {"type": "item", "name": "Item", "settings": [
      {"type": "select", "id": "icon", "label": "Icon",
       "options": [
         {"value": "truck", "label": "Truck"},
         {"value": "shield", "label": "Shield"},
         {"value": "rotate", "label": "Returns"},
         {"value": "bolt", "label": "Bolt"}
       ], "default": "bolt"},
      {"type": "text", "id": "title", "label": "Title"},
      {"type": "text", "id": "subtitle", "label": "Subtitle"}
    ]}
  ],
  "presets": [{"name": "ESTRY Trust Bar"}]
}
{% endschema %}
