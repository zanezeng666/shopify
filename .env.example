# ============================================================
# Shopify Admin 配置模板 — 复制为 .env 后填写
# ============================================================

# ---- 新库 shopify_new（本工程主库，可写）----
SHOPIFY_DB_HOST=gz-cdb-aq76i6tl.sql.tencentcdb.com
SHOPIFY_DB_PORT=63698
SHOPIFY_DB_USER=root
SHOPIFY_DB_PASSWORD=
SHOPIFY_DB_NAME=shopify_new
SHOPIFY_DB_CHARSET=utf8mb4

# ---- 老库（只读，仅迁移脚本使用）----
LEGACY_DB_HOST=gz-cdb-aq76i6tl.sql.tencentcdb.com
LEGACY_DB_PORT=63698
LEGACY_DB_USER=root
LEGACY_DB_PASSWORD=
LEGACY_DB_NAME=shopify

# ---- REST API 鉴权（逗号分隔多个 key；留空 = 不鉴权，仅限本地调试）----
API_KEYS=

# ---- Shopify Admin API ----
# API 版本与重试
# SHOPIFY_API_VERSION=2024-10
# SHOPIFY_API_MAX_RETRIES=5
# 出网代理（国内访问 *.myshopify.com 通常需要；Clash Verge 默认 mixed 端口 7897；留空=直连）
SHOPIFY_PROXY=http://127.0.0.1:7897
SHOPIFY_API_VERSION=2024-10
SHOPIFY_API_TIMEOUT=30
SHOPIFY_API_MAX_RETRIES=5

# ---- FastRite 海外仓 API ----
FASTRITE_API_BASE=
FASTRITE_APP_KEY=
FASTRITE_APP_SECRET=

# ---- 定时任务 ----
SCHEDULER_ENABLED=false

# ---- 运费同步（CS 费率 → Shopify Carrier Service 实时回调）----
SHIPPING_MARKUP=1.2
SHIPPING_ORIGIN=US
# 注册承运商时用的本服务公网 HTTPS 基址（例 https://api.example.com）
SHIPPING_CALLBACK_BASE_URL=
# 拉单周期（cron 表达式，默认每 10 分钟）
SCHEDULER_PULL_ORDERS_CRON=*/10 * * * *
# 自动履约周期（分仓路由；默认每 15 分钟）
SCHEDULER_FULFILL_CRON=*/15 * * * *
# 渠道状态轮询周期（默认每 30 分钟）
SCHEDULER_CHANNEL_POLL_CRON=*/30 * * * *
# 库存同步周期（默认每 60 分钟）
SCHEDULER_INVENTORY_SYNC_CRON=0 * * * *
# 日报生成时刻（默认每天 08:10）
SCHEDULER_REPORTS_CRON=10 8 * * *
# 自动履约是否自动提交渠道订单（默认 false 只分仓不下单）
SCHEDULER_AUTO_SUBMIT=false
# 库存同步单轮上限（首轮全量收敛限流，余量下轮继续）
SCHEDULER_INVENTORY_MAX_PER_RUN=2000

# ---- MCP ----
MCP_SERVER_NAME=shopify-admin
# stdio 模式权限级别：read（只读）| general（可同步）| admin（可写）
MCP_LEVEL=read
# SSE 模式令牌表（格式 token:级别，逗号分隔；留空 = SSE 只读）
MCP_TOKENS=

# ============================================================
# 以下键透传给 bmai（CS 供应商）——本工程 settings 读入后
# 注入进程环境变量，bmai 自行读取，保证单一配置源
# ============================================================

# ---- CS 数据库（cs_new 库，bmai 自管）----
CS_DB_HOST=gz-cdb-aq76i6tl.sql.tencentcdb.com
CS_DB_PORT=63698
CS_DB_USER=root
CS_DB_PASSWORD=
CS_DB_NAME=cs_new

# ---- CIM API 凭据（CS 供应商平台登录）----
CS_CIM_DOMAIN=https://cim.cameronsino.com/admin-api/cim
CS_CIM_AUTH_URL=https://cim.cameronsino.com/admin-api/cim/auth/login
CS_CIM_TENANT_ID=1
CS_CIM_USERNAME=
CS_CIM_PASSWORD=
BMAI_RCUSTOMERNO=

# ---- 海外仓数据库（fast_rite 库，FastRite 渠道读取）----
FASTRITE_DB_HOST=gz-cdb-aq76i6tl.sql.tencentcdb.com
FASTRITE_DB_PORT=63698
FASTRITE_DB_USER=root
FASTRITE_DB_PASSWORD=
FASTRITE_DB_NAME=fast_rite

# ---- 邮件告警（任务失败通知）----
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=
